# Copy to .env and fill in. `npm run dev` loads it for both the web app and the API.

# --- AI review (task fit and explanation) -------------------------------------------
# Without a key the app still works and grades code quality only.
ANTHROPIC_API_KEY=
# auto (on when a key is present) | off
CODEGRADE_AI_REVIEW=auto
CODEGRADE_AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CODEGRADE_AI_EFFORT=high
# Free plan: AI reviews per visitor per day, and for the whole service per day.
CODEGRADE_AI_REVIEWS_PER_DAY=5
CODEGRADE_AI_DAILY_BUDGET=200

# --- API ----------------------------------------------------------------------------
# Comma-separated CORS allow-list.
CODEGRADE_ALLOWED_ORIGINS=http://localhost:5173
CODEGRADE_MAX_UPLOAD_MB=5
# Requests per visitor per minute.
CODEGRADE_RATE_LIMIT=20

# --- Web app ------------------------------------------------------------------------
# Base URL of the API. Leave empty in development: Vite proxies /api to :8000.
VITE_API_URL=
