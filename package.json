{
  "name": "codeflow-ui",
  "private": true,
  "version": "1.0.0",
  "description": "CodeFlow: a web app that grades your code Excellent, Good or Poor. React 19 + TypeScript front end, FastAPI + a from-scratch static analyzer behind it.",
  "license": "MIT",
  "author": "DaniloK77 (https://github.com/DaniloK77)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniloK77/CodeFlow-UI-.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node scripts/dev.mjs api",
    "setup:api": "python3 -m venv .venv && .venv/bin/pip install -r api/requirements-dev.txt",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": ".venv/bin/python -m pytest",
    "quality": ".venv/bin/python -m tools.codegrade src tools api scripts --fail-under 90",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run test:api && npm run quality && npm run build",
    "fixtures": "node --experimental-strip-types --no-warnings scripts/dump-examples.mjs | .venv/bin/python -m scripts.record_fixtures"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-syntax-highlighter": "^16.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
